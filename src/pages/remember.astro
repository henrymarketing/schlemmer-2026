---
import Layout from '../layouts/Layout.astro';
import entries from '../data/remember.json';
---

<Layout
  title="We Remember"
  description="Remembering key figures of the Bauhaus movement and the arts community."
  currentPath="/remember"
>
  <main class="lp">
    <div class="lp__inner">
      <h1 class="lp__title">We Remember</h1>

      {entries.map((entry) => (
        <article class={`lp__entry${entry.images.length === 0 ? ' lp__entry--full' : ''}`}>
          <div class="lp__text">
            <div class="lp__heading" set:html={entry.titleHtml} />
            {entry.bodyHtml && <div class="lp__body" set:html={entry.bodyHtml} />}
            {entry.audioEmbed && <div class="lp__audio" set:html={entry.audioEmbed} />}
            {entry.detailLinks.length > 0 && (
              <div class="lp__links">
                {entry.detailLinks.map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" class="lp__btn">
                    {link.label}
                  </a>
                ))}
              </div>
            )}
          </div>
          {entry.images.length > 0 && (
            <div class="lp__media">
              {entry.images.map((img) => (
                img.href ? (
                  <a href={img.href} target="_blank" rel="noopener noreferrer">
                    <img src={img.src} srcset={img.srcset} sizes={img.sizes}
                      alt={img.alt} width={img.width} loading="lazy"
                      data-lightbox data-caption={img.caption} />
                  </a>
                ) : (
                  <img src={img.src} srcset={img.srcset} sizes={img.sizes}
                    alt={img.alt} width={img.width} loading="lazy"
                    data-lightbox data-caption={img.caption} />
                )
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </main>
</Layout>

<style>
  .lp {
    background: #000;
    padding: 3.5rem 0 6rem;
  }

  .lp__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .lp__title {
    font-family: "Century Gothic", "Questrial", sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.35);
    margin: 0 0 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .lp__entry {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    align-items: start;
  }

  .lp__entry--full {
    grid-template-columns: 1fr;
    max-width: 640px;
  }

  .lp__entry:last-child {
    border-bottom: none;
  }

  .lp__media {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .lp__media img {
    max-width: 100%;
    display: block;
  }

  .lp__media a {
    display: block;
  }

  .lp__audio {
    margin-top: 1rem;
  }

  .lp__links {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .lp__btn {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 0.5rem 1.1rem;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }

  .lp__btn:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.6);
  }

  .lp__heading :global(.schlemmer-text),
  .lp__body :global(.schlemmer-text) {
    column-count: 1 !important;
    font-size: 0.9rem !important;
    line-height: 1.75 !important;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 0.75em;
  }

  .lp__heading :global(.highlight) {
    color: rgba(255, 255, 255, 0.9);
    font-weight: 400;
  }

  .lp__heading :global(a.highlight),
  .lp__heading :global(.schlemmer-link) {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.25);
  }

  .lp__heading :global(a.highlight:hover),
  .lp__heading :global(.schlemmer-link:hover) {
    text-decoration-color: rgba(255, 255, 255, 0.7);
  }

  @media (max-width: 767px) {
    .lp__inner {
      padding: 0 1.25rem;
    }

    .lp__entry {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .lp__entry--full {
      max-width: none;
    }
  }
</style>
