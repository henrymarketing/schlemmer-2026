---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/catalogue-raisonne.html'), 'utf-8');
---

<Layout
  title="Catalogue Raisonné"
  description="Catalogues Raisonnés of artworks by Oskar Schlemmer were published in 1952, 1965, and 1979."
  currentPath="/catalogue-raisonne"
>
  <section class="main-section schlemmer-page">
    <div set:html={html} />
  </section>
</Layout>
