---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Oskar Schlemmer"
  description="A lecture by C. Raman Schlemmer on Oskar Schlemmer — artist, choreographer and Bauhaus Master — at the National Gallery of Zimbabwe, Harare, 27 November 2026."
  ogImage="/images/harare-lecture-flyer-og.jpg"
  currentPath="/"
>
  <main class="hero">
    <div class="hero__inner">

      <div class="hero__images">
        <a href="/images/harare-lecture-flyer-1600.webp" target="_blank" rel="noopener" class="hero__flyer-link">
          <img
            src="/images/harare-lecture-flyer-1000.webp"
            srcset="/images/harare-lecture-flyer-600.webp 600w, /images/harare-lecture-flyer-1000.webp 1000w, /images/harare-lecture-flyer-1600.webp 1600w"
            sizes="(max-width: 767px) 90vw, 420px"
            alt="Lecture flyer: Oskar Schlemmer — The Dancing Artist + The Bauhaus. Guest lecture by C. Raman Schlemmer, 27 November 2026, 10–13 o'clock, National Gallery of Zimbabwe, 20 Julius Nyerere Way, Harare. Harare Conversations."
            class="hero__flyer"
            width="1000"
            height="1414"
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>

      <div class="hero__text">
        <p class="hero__date">27 November 2026 &middot; National Gallery of Zimbabwe, Harare</p>
        <h1 class="hero__heading">
          A lecture on<br>Oskar Schlemmer<br>(1888&thinsp;&ndash;&thinsp;1943)
        </h1>
        <p class="hero__body">
          A lecture by C.&nbsp;Raman Schlemmer at the National Gallery of Zimbabwe, Harare, on
          27&nbsp;November&nbsp;2026. Possibly the first lecture in Africa devoted to the life and work
          of Oskar Schlemmer, the artist, choreographer and Bauhaus Master.
        </p>
        <p class="hero__body">
          Conceived as a personal educational contribution to students, artists and the wider cultural
          community in Zimbabwe, this initiative is offered by C.&nbsp;Raman Schlemmer in the spirit of
          sharing knowledge, oral history and first-hand insights into the legacy of Oskar Schlemmer
          with new audiences internationally.
        </p>
        <p class="hero__note">
          In collaboration with the National Gallery of Zimbabwe Harare Conversations<br>
          This is an in-person event and will not be available online
        </p>
      </div>

    </div>

    <div class="hero__more">
      <div class="hero__ctas">
        <a href="/slideshow" class="hero__btn">› View Works</a>
        <a href="https://mint.schlemmer.org" target="_blank" rel="noopener noreferrer" class="hero__btn hero__btn--outline">› Mint a Bauhaus Signet</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .hero {
    background: #000;
    min-height: calc(100vh - 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero__inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 3rem 3.5rem;
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  /* ─── Images column ─────────────────────── */
  .hero__images {
    flex: 0 0 42%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .hero__flyer-link {
    display: block;
  }

  .hero__flyer {
    width: auto;
    max-width: 100%;
    max-height: 80vh;
    height: auto;
    display: block;
  }

  /* ─── Text column ───────────────────────── */
  .hero__text {
    flex: 1;
  }

  .hero__date {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1rem;
  }

  .hero__heading {
    font-family: "Century Gothic", "Questrial", sans-serif;
    font-size: 1.55rem;
    font-weight: 400;
    line-height: 1.5;
    color: #fff;
    margin: 0 0 1.5rem;
  }

  .hero__body {
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 1.25rem;
    max-width: 46ch;
  }

  .hero__note {
    font-size: 0.75rem;
    line-height: 1.7;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 2rem;
    max-width: 52ch;
  }

  /* ─── Separate links below the news entry ── */
  .hero__more {
    width: calc(100% - 6rem);
    max-width: calc(1100px - 6rem);
    margin: 0 auto;
    padding: 2.5rem 0 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .hero__btn {
    display: inline-block;
    font-family: inherit;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #000;
    background: #fff;
    text-decoration: none;
    padding: 0.7rem 1.6rem;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .hero__btn:hover {
    opacity: 0.75;
  }

  .hero__btn--outline {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .hero__btn--outline:hover {
    border-color: rgba(255, 255, 255, 0.7);
    opacity: 1;
  }

  .hero__caption {
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  /* ─── Mobile ────────────────────────────── */
  @media (max-width: 767px) {
    .hero {
      min-height: auto;
    }

    .hero__inner {
      flex-direction: column-reverse;
      padding: 2.5rem 1.25rem 2.5rem;
      gap: 2rem;
    }

    .hero__more {
      width: calc(100% - 2.5rem);
      padding: 2rem 0 3rem;
    }

    .hero__images {
      flex: none;
      width: 100%;
      flex-direction: row;
      align-items: flex-end;
      justify-content: center;
      gap: 1.5rem;
    }

    .hero__flyer {
      max-height: none;
      width: 100%;
      max-width: 420px;
    }

    .hero__heading {
      font-size: 1.2rem;
    }

    .hero__body {
      font-size: 0.875rem;
      max-width: none;
    }
  }
</style>
