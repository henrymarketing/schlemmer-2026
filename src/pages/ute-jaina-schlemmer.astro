---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/ute-jaina-schlemmer.html'), 'utf-8');
---

<Layout
  title="Jaïna Schlemmer"
  description="Jaïna Schlemmer dedicated her life to preserving the legacy of her legendary artist father, Oskar Schlemmer."
  currentPath="/ute-jaina-schlemmer"
>
  <section class="html-page">
    <div set:html={html} />
  </section>
</Layout>

<style>
  .html-page {
    background: #000;
    padding: 3rem 0 6rem;
  }

  .html-page :global(.triadic-ballet-container) {
    max-width: 1100px;
    margin: 0 auto;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
    box-sizing: border-box;
  }

  .html-page :global(.w-layout-blockcontainer),
  .html-page :global(.w-container) {
    max-width: 1100px;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .html-page :global(.w-layout-blockcontainer),
    .html-page :global(.w-container),
    .html-page :global(.triadic-ballet-container) {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>
