---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/c-raman-schlemmer.html'), 'utf-8');
---

<Layout
  title="C. Raman Schlemmer"
  description="C. Raman Schlemmer is the curator and keeper of The Oskar Schlemmer Theatre Estate and Archives."
  currentPath="/c-raman-schlemmer"
>
  <main class="html-page">
    <div set:html={html} />
  </main>
</Layout>

<style>
  .html-page {
    background: #000;
    padding: 3rem 0 6rem;
  }

  .html-page :global(.triadic-ballet-container) {
    max-width: 1100px;
    margin: 0 auto;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
    box-sizing: border-box;
  }

  .html-page :global(.w-layout-blockcontainer),
  .html-page :global(.w-container) {
    max-width: 1100px;
    padding-left: 2.5rem;
    padding-right: 2.5rem;
    box-sizing: border-box;
  }

  @media (max-width: 767px) {
    .html-page :global(.w-layout-blockcontainer),
    .html-page :global(.w-container),
    .html-page :global(.triadic-ballet-container) {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }
</style>
