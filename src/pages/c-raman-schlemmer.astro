---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/c-raman-schlemmer.html'), 'utf-8');
---

<Layout
  title="C. Raman Schlemmer"
  description="C. Raman Schlemmer, is the curator and keeper of The Oskar Schlemmer Theatre Estate and Archives, Bühnen Archiv Oskar Schlemmer."
  currentPath="/c-raman-schlemmer"
>
  <section class="main-section schlemmer-page">
    <div set:html={html} />
  </section>
</Layout>
