---
import Layout from '../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/oskar-schlemmer.html'), 'utf-8');
---

<Layout
  title="Oskar Schlemmer"
  description="From 1923 Oskar Schlemmer directed the Bauhaus theatre workshop and created the series of Bauhaus Dances, which toured in 1929."
  currentPath="/oskar-schlemmer"
>
  <section class="main-section schlemmer-page">
    <div set:html={html} />
  </section>
</Layout>
