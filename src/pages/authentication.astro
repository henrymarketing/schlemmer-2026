---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Authentication"
  description="Authentication of works by Oskar Schlemmer — Application Form."
  currentPath="/authentication"
>
  <section class="auth-page">
    <div class="auth-page__inner">

      <h1 class="auth-page__title">
        Authentication of Works<br>by Oskar Schlemmer
      </h1>
      <p class="auth-page__subtitle">Application Form</p>

      <div class="auth-page__rule"></div>

      <p class="auth-page__lead">
        <strong>Invitation to collectors, auction houses, art dealers, art historians and museums</strong>
      </p>
      <p class="auth-page__lead">
        Call for information on works of art, photographs and documents by Oskar Schlemmer
        that have not yet been registered.
      </p>

      <div class="auth-page__rule"></div>

      <div id="auth-success" class="auth-success" hidden>
        <p>Thank you — your enquiry has been received. We will be in touch.</p>
      </div>
      <div id="auth-error" class="auth-error" hidden>
        <p>Something went wrong. Please try again or email us directly.</p>
      </div>

      <form class="auth-form" id="auth-form" method="post" action="/api/contact" novalidate>

        <div class="auth-form__row">
          <div class="auth-form__field">
            <label class="form-label" for="First-Name">First Name *</label>
            <input class="form-input" type="text" id="First-Name" name="First-Name" maxlength="256" required />
          </div>
          <div class="auth-form__field">
            <label class="form-label" for="Last-Name">Last Name *</label>
            <input class="form-input" type="text" id="Last-Name" name="Last-Name" maxlength="256" required />
          </div>
        </div>

        <div class="auth-form__row">
          <div class="auth-form__field">
            <label class="form-label" for="Email">Email *</label>
            <input class="form-input" type="email" id="Email" name="Email" maxlength="256" required />
          </div>
          <div class="auth-form__field">
            <label class="form-label" for="Telephone">Telephone <span class="auth-form__note">(including country code) *</span></label>
            <input class="form-input" type="tel" id="Telephone" name="Telephone-Contact-including-country-code" maxlength="256" required />
          </div>
        </div>

        <div class="auth-form__row">
          <div class="auth-form__field">
            <label class="form-label" for="Institution">Institution *</label>
            <input class="form-input" type="text" id="Institution" name="Institution" maxlength="256" required />
          </div>
          <div class="auth-form__field">
            <label class="form-label" for="Street">Street *</label>
            <input class="form-input" type="text" id="Street" name="Street" maxlength="256" required />
          </div>
        </div>

        <div class="auth-form__field">
          <label class="form-label" for="City">City and Zip code *</label>
          <input class="form-input" type="text" id="City" name="City-and-Zip-code" maxlength="256" required />
        </div>

        <div class="auth-form__field">
          <label class="form-label" for="Country">Country *</label>
          <input class="form-input" type="text" id="Country" name="Country" maxlength="256" required />
        </div>

        <div class="auth-form__field">
          <label class="form-label" for="Reference">Reference</label>
          <input class="form-input" type="text" id="Reference" name="Reference" maxlength="256" />
        </div>

        <div class="auth-form__field">
          <label class="form-label" for="Website">Website</label>
          <input class="form-input" type="url" id="Website" name="Website" maxlength="256" />
        </div>

        <div class="auth-form__field">
          <label class="form-label" for="Request">Type of Request *</label>
          <textarea
            class="form-input auth-form__textarea"
            id="Request"
            name="Request"
            maxlength="5000"
            placeholder="Substantiation of your information, details or enquiry"
            required
          ></textarea>
        </div>

        <div class="auth-form__rule"></div>

        <p class="auth-form__section-label">Request category (select all that apply)</p>

        <div class="auth-form__checks">
          {[
            { id: 'Authentication', label: 'Authentication Application' },
            { id: 'Reproduction-Publication', label: 'Reproduction, Publication Application' },
            { id: 'Provenance-Research', label: 'Provenance Research' },
            { id: 'Art-Market', label: 'Art Market' },
            { id: 'Academia', label: 'Academia' },
            { id: 'Media', label: 'Media' },
            { id: 'Trademark-Request', label: 'Trademark Request' },
          ].map(({ id, label }) => (
            <label class="auth-form__check-label">
              <input class="form-checkbox" type="checkbox" id={id} name={id} />
              <span>{label}</span>
            </label>
          ))}
        </div>

        <div class="auth-form__rule"></div>

        <label class="auth-form__check-label auth-form__declaration">
          <input class="form-checkbox" type="checkbox" id="Declaration" name="Decleration-correct-info" required />
          <span>I declare the information provided is correct. *</span>
        </label>

        <!-- honeypot: hidden from real users, bots fill it in -->
        <div class="auth-form__hp" aria-hidden="true">
          <label for="_hp">Leave this blank</label>
          <input type="text" id="_hp" name="_hp" tabindex="-1" autocomplete="off" />
        </div>
        <!-- timestamp set on load by script below -->
        <input type="hidden" name="_t" id="_t" />

        <button type="submit" class="btn-primary auth-form__submit" id="auth-submit">Submit</button>

      </form>

      <script>
        const form   = document.getElementById('auth-form') as HTMLFormElement;
        const submit = document.getElementById('auth-submit') as HTMLButtonElement;
        const success = document.getElementById('auth-success') as HTMLElement;
        const errorBox = document.getElementById('auth-error') as HTMLElement;

        (document.getElementById('_t') as HTMLInputElement).value = String(Date.now());

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!form.checkValidity()) { form.reportValidity(); return; }

          submit.disabled = true;
          submit.textContent = 'Sending…';
          errorBox.hidden = true;

          try {
            const res = await fetch('/api/contact', {
              method: 'POST',
              body: new FormData(form),
            });
            if (res.ok) {
              form.hidden = true;
              success.hidden = false;
            } else {
              errorBox.hidden = false;
              submit.disabled = false;
              submit.textContent = 'Submit';
            }
          } catch {
            errorBox.hidden = false;
            submit.disabled = false;
            submit.textContent = 'Submit';
          }
        });
      </script>

      <div class="auth-page__rule"></div>

      <div class="auth-page__block">
        <p>
          Please fill in the form with complete and detailed information. All entries marked with a
          star (*) are mandatory. Forms that are incomplete, with mandatory information not filled in,
          cannot be considered and will not be followed up.
        </p>
        <p>
          Please contact us with information on previously unrecorded original works by Oskar Schlemmer
          by filling in the form with all details available to you. Information on changes of ownership,
          as well as information that was not correctly published in 1965 or 1979, can also be submitted.
        </p>
        <p>We will, of course, treat all information confidentially.</p>
        <p>
          Further information on Catalogues Raisonnés of artworks by Oskar Schlemmer,
          <a href="/catalogue-raisonne" class="auth-page__link">see Oskar Schlemmer Literature</a>.
        </p>
        <p>
          In the future, the internally updated catalogues raisonné will serve as an authoritative
          source of information on Oskar Schlemmer for researchers, museums, collectors, and art
          dealers upon request.
        </p>
      </div>

    </div>
  </section>
</Layout>

<style>
  .auth-page {
    background: #000;
    padding: 3.5rem 0 7rem;
  }

  .auth-page__inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .auth-page__title {
    font-family: "Century Gothic", "Questrial", sans-serif;
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.4;
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .auth-page__subtitle {
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin: 0 0 2.5rem;
  }

  .auth-page__rule,
  .auth-form__rule {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 2rem 0;
  }

  .auth-page__lead {
    font-size: 0.95rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.8);
    margin: 0 0 1em;
  }

  .auth-page__lead strong {
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .auth-page__block {
    display: flex;
    flex-direction: column;
    gap: 1em;
  }

  .auth-page__block p {
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .auth-page__link {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 255, 255, 0.3);
  }

  .auth-page__link:hover {
    text-decoration-color: rgba(255, 255, 255, 0.7);
  }

  /* ─── Success / error ──────────────────────── */
  .auth-success,
  .auth-error {
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .auth-success {
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.85);
  }

  .auth-error {
    border: 1px solid rgba(220, 80, 80, 0.5);
    color: rgba(220, 100, 100, 0.9);
  }

  .auth-success p,
  .auth-error p {
    margin: 0;
  }

  /* ─── Form ─────────────────────────────────── */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .auth-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .auth-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .auth-form__note {
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.4);
    text-transform: none;
    font-weight: 400;
  }

  .auth-form__textarea {
    min-height: 120px;
    resize: vertical;
    font-family: inherit;
    line-height: 1.6;
  }

  .auth-form__section-label {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    margin: 0;
  }

  .auth-form__checks {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .auth-form__check-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.4;
  }

  .auth-form__declaration {
    color: rgba(255, 255, 255, 0.85);
  }

  .auth-form__submit {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .auth-form__hp {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .auth-page__inner {
      padding: 0 1.25rem;
    }

    .auth-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
