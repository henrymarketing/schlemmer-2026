---
import Layout from '../../layouts/Layout.astro';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const html = readFileSync(resolve('src/data/html/mizmorim-kammermusik-festival.html'), 'utf-8');
---

<Layout
  title="Mizmorim Kammermusik Festival"
  description="Mizmorim Kammermusik Festival. Review Music by C. Raman Schlemmer."
  currentPath="/features/mizmorim-kammermusik-festival"
>
  <section class="main-section schlemmer-page">
    <div set:html={html} />
  </section>
</Layout>
