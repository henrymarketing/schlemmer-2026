---
interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const navItems = [
  { href: '/oskar-schlemmer',     label: 'Oskar Schlemmer, Work and Life' },
  { href: '/triadic-ballet',      label: 'The Triadic Ballet' },
  { href: '/catalogue-raisonne',  label: 'Catalogue Raisonné' },
  { href: '/ute-jaina-schlemmer', label: 'Jaïna Schlemmer' },
  { href: '/c-raman-schlemmer',   label: 'C. Raman Schlemmer' },
  { href: '/communique',          label: 'Communiqué' },
  { href: '/authentication',      label: 'Authentication' },
  { href: '/friends',             label: 'Friends' },
  { href: '/features',            label: 'Features' },
  { href: '/remember',            label: 'We Remember' },
];
---

<header class="site-nav">
  <div class="site-nav__inner">
    <a
      href="/"
      class="site-nav__brand"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      Oskar Schlemmer
    </a>
    <button
      id="nav-toggle"
      class="site-nav__toggle"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="nav-overlay"
    >
      <img src="/images/schlemmer-menu.png" loading="lazy" alt="" width="90" />
    </button>
  </div>
</header>

<nav id="nav-overlay" class="nav-overlay" aria-label="Site navigation" aria-hidden="true">
  <button id="nav-close" class="nav-overlay__close" aria-label="Close navigation">×</button>
  {navItems.map(({ href, label }) => (
    <a
      href={href}
      class="nav-overlay__item"
      aria-current={currentPath === href ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<script>
  const toggle  = document.getElementById('nav-toggle')!;
  const overlay = document.getElementById('nav-overlay')!;
  const close   = document.getElementById('nav-close')!;

  function openNav() {
    overlay.classList.add('open');
    overlay.removeAttribute('aria-hidden');
    toggle.setAttribute('aria-expanded', 'true');
    close.focus();
  }
  function closeNav() {
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden', 'true');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.focus();
  }

  toggle.addEventListener('click', openNav);
  close.addEventListener('click', closeNav);
  overlay.querySelectorAll('a').forEach(a => a.addEventListener('click', closeNav));
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNav(); });
</script>

<style>
  /* ─── Top bar ───────────────────────────────── */
  .site-nav {
    background: #fff;
    position: relative;
    z-index: 5;
  }

  .site-nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 88%;
    margin: 0 auto;
    padding: 2rem 0;
  }

  /* ─── Wordmark ──────────────────────────────── */
  .site-nav__brand {
    font-family: "Century Gothic", "Questrial", ui-sans-serif, sans-serif;
    font-size: 2.875rem;
    font-weight: 300;
    color: #000;
    text-decoration: none;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .site-nav__brand:hover {
    opacity: 0.7;
  }

  /* ─── Hamburger toggle ──────────────────────── */
  .site-nav__toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .site-nav__toggle:hover {
    opacity: 1;
  }

  .site-nav__toggle img {
    display: block;
    padding: 5px 0;
  }

  /* ─── Overlay — styles live in globals.css ── */
  /* (.nav-overlay, .nav-overlay.open, .nav-overlay__item, .nav-overlay__close) */

  /* Active page link dims in overlay */
  .nav-overlay__item[aria-current="page"] {
    color: rgba(255, 255, 255, 0.4);
    pointer-events: none;
  }

  /* ─── Responsive ────────────────────────────── */
  @media (max-width: 767px) {
    .site-nav__inner {
      max-width: 100%;
      padding: 1.25rem 1.25rem;
    }

    .site-nav__brand {
      font-size: 1.5rem;
    }

    .site-nav__toggle img {
      width: 64px;
    }
  }
</style>
